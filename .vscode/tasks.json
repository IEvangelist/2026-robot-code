			"command": "& .\\gradlew.bat run -PswerveSim --no-daemon --console=plain; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Simulate TalonFX swerve (terminal)",
			"type": "shell",
			"command": "& .\\gradlew.bat test --tests frc.robot.subsystems.SimTalonFXDrivetrainTest --no-daemon --console=plain; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}